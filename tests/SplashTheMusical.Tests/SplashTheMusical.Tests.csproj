<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Allocations.cs asserts the exact bytes a call allocates. With dynamic PGO, the tier-1 code the property tests'
      profile gives the flowchart parser allocates 24 bytes more than the code the JIT compiles without it, so the
      count would depend on which tests ran first.
    -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="VerificationGlue" />
    <PackageReference Include="VerificationGlue.Mocks" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SplashTheMusical/SplashTheMusical.csproj" />
    <ProjectReference Include="../../src/SplashTheMusical.DependencyModule/SplashTheMusical.DependencyModule.csproj" />
    <ProjectReference Include="../../src/SplashTheMusical.Layout/SplashTheMusical.Layout.csproj" />
    <ProjectReference Include="../../src/SplashTheMusical.Cli/SplashTheMusical.Cli.csproj" />
    <ProjectReference Include="../SplashTheMusical.Benchmarks/SplashTheMusical.Benchmarks.csproj" />
    <ProjectReference Include="../../tools/SplashTheMusical.Upstream/SplashTheMusical.Upstream.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
