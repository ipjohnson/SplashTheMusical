<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The native runner checks the corpus with the same tests as dotnet test. AwesomeAssertions is not trim safe, so
         these tests use VerificationGlue's checks, whose messages are generated at compile time. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="VerificationGlue" />
    <PackageReference Include="VerificationGlue.Mocks" />
    <!-- Mermaider's layout engine, scored against ELK by ElkBaselineTests. No project under src references it. -->
    <PackageReference Include="Sugiyama" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SplashTheMusical/SplashTheMusical.csproj" />
    <ProjectReference Include="../../src/SplashTheMusical.Layout/SplashTheMusical.Layout.csproj" />
    <!-- ILC compiles all of the core, not only what the tests reach, and Assembly.Load finds it by name. -->
    <TrimmerRootAssembly Include="SplashTheMusical" />
  </ItemGroup>
</Project>
