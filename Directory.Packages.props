<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- src/SplashTheMusical.DependencyModule -->
    <PackageVersion Include="DependencyModules.Runtime" Version="1.7.0" />
    <PackageVersion Include="DependencyModules.SourceGenerator" Version="1.7.0" />
    <!-- The container of the tests and the sample -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="TUnit" Version="1.83.8" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="VerificationGlue" Version="0.1.0-preview.1" />
    <PackageVersion Include="VerificationGlue.Mocks" Version="0.1.0-preview.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Benchmark dependencies -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The baseline STM is measured against -->
    <PackageVersion Include="Mermaider" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- tools/SplashTheMusical.Upstream reads mermaid's config.schema.yaml, which uses anchors -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
