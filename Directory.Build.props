<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <_RepoRelativeProjectDirectory>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).Replace('\','/'))</_RepoRelativeProjectDirectory>
  </PropertyGroup>

  <!-- src/ projects: the trim, AOT and single-file analyzers -->
  <PropertyGroup Condition="$(_RepoRelativeProjectDirectory.StartsWith('src/'))">
    <IsAotCompatible>true</IsAotCompatible>
    <PackageIcon>06-nuget-purple.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="$(_RepoRelativeProjectDirectory.StartsWith('src/'))">
    <None Include="$(MSBuildThisFileDirectory)artwork/06-nuget-purple.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup Condition="$(_RepoRelativeProjectDirectory.StartsWith('tests/'))">
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
